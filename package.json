{
  "name": "autenticacao-jwt",
  "version": "1.0.0",
  "description": "Sistema completo de autenticação com JWT, Node.js, Express e MongoDB. Inclui registro ilimitado, login, rotas protegidas, sistema de roles, cadastro em massa e configuração Docker.",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker logs auth_jwt_mongodb",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:atlas": "node test-atlas-connection.js",
    "config:atlas": "powershell -ExecutionPolicy Bypass -File config-atlas-simples.ps1",
    "config:atlas-full": "powershell -ExecutionPolicy Bypass -File configurar-atlas.ps1",
    "users:create": "powershell -ExecutionPolicy Bypass -File cadastrar-usuarios.ps1",
    "security:scan": "python -m ggshield secret scan repo . || powershell -ExecutionPolicy Bypass -File scripts/security-scan-basic.ps1",
    "security:scan-basic": "powershell -ExecutionPolicy Bypass -File scripts/security-scan-basic.ps1",
    "security:precommit": "powershell -ExecutionPolicy Bypass -File scripts/pre-commit-gitguardian.ps1",
    "security:install": "powershell -ExecutionPolicy Bypass -File scripts/install-gitguardian.ps1",
    "security:install-ggshield": "powershell -ExecutionPolicy Bypass -File scripts/install-gitguardian.ps1"
  },
  "keywords": [
    "nodejs",
    "express",
    "jwt",
    "authentication",
    "mongodb",
    "api",
    "rest-api",
    "bcrypt",
    "docker",
    "postman",
    "middleware",
    "cors",
    "helmet",
    "mass-registration",
    "validation",
    "security",
    "gitguardian",
    "secret-detection"
  ],
  "author": "Leo ST <leo.st@exemplo.com>",
  "license": "MIT",
  "homepage": "https://github.com/LeoST25/autenticacao-jwt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeoST25/autenticacao-jwt.git"
  },
  "bugs": {
    "url": "https://github.com/LeoST25/autenticacao-jwt/issues"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
