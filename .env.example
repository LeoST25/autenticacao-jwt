# Arquivo de exemplo das variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Configuração do Servidor
PORT=3000
NODE_ENV=development

# Configuração do MongoDB
MONGODB_URI=mongodb://app_user:app_password@localhost:27017/auth_jwt

# Configuração do JWT
JWT_SECRET=seu_jwt_secret_super_secreto_aqui_123456789
JWT_EXPIRES_IN=7d

# Configuração do Bcrypt
BCRYPT_ROUNDS=12